# Copy to .env.local (never commit that file) and fill in from
# Supabase dashboard → Project Settings → API Keys.
# The publishable key (sb_publishable_…) is meant to be public: row-level security protects every board.
# Never put the secret / service_role key here or anywhere in the app.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# (Older projects: VITE_SUPABASE_ANON_KEY=your-anon-key also works.)
